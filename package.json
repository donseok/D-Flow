{
  "name": "d-flow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "predev": "node scripts/check-env-target.mjs",
    "dev": "next dev",
    "env:local": "node scripts/env-swap.mjs local",
    "env:staging": "node scripts/env-swap.mjs staging",
    "env:prod": "node scripts/env-swap.mjs prod",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "node scripts/baseline-diff.mjs",
    "db:diff:baseline": "supabase db reset --version 0001 && node scripts/baseline-diff.mjs && supabase migration up --local",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs",
    "minutes:sweep": "node scripts/minutes/sweep-attachments.mjs",
    "settings:verify": "node scripts/settings-verify.mjs",
    "accept:synthetic": "node scripts/e2e-synthetic.mjs",
    "catalog:write": "node scripts/settings-catalog.mjs",
    "jobs:write": "node scripts/jobs-vercel-crons.mjs",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run -c vitest.config.rls.ts",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "wiki:health": "node scripts/wiki-health.mjs",
    "embed:repair": "node scripts/embed-repair.mjs",
    "wbs:merge": "node scripts/wbs/merge-groups.mjs",
    "wbs:validate": "node scripts/wbs/validate.mjs",
    "wbs:build": "node scripts/wbs/build-xlsx.mjs",
    "mark:good": "node scripts/mark-good.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.22.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "next": "15.5.19",
    "nodemailer": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
