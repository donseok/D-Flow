    { "key": "p-attendance", "path": "/p/{pid}/attendance", "file": "(app)/p/[projectId]/attendance/page.tsx", "grade": "member", "tags": ["P", "S"], "since": "b4283c0" },
    { "key": "p-agents", "path": "/p/{pid}/agents", "file": "(app)/p/[projectId]/agents/page.tsx", "grade": "member", "tags": ["P", "F"], "since": "b4283c0" },
    { "key": "p-office", "path": "/p/{pid}/agents/office", "file": "(app)/p/[projectId]/agents/office/page.tsx", "grade": "member", "tags": ["P"], "since": "b4283c0", "init": { "dflow.office.chatter": "0" }, "expect": ["[data-roster-desk]"] },
    { "key": "p-office-lane", "path": "/p/{pid}/agents/office", "file": "(app)/p/[projectId]/agents/office/page.tsx", "grade": "member", "tags": ["P"], "since": "b4283c0", "supplement": true, "init": { "dflow.office.chatter": "0" }, "click": "[data-view=\"lane\"]", "expect": ["[data-state=\"BLOCKED\"]"] },
    { "key": "p-settings", "path": "/p/{pid}/settings", "file": "(app)/p/[projectId]/settings/page.tsx", "grade": "wsAdmin", "tags": ["P", "S"], "since": "b4283c0" },
