{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/inbox-retention",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/form-templates-gc",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/ai-index",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/wiki/worker",
      "schedule": "30 18 * * *"
    }
  ]
}
