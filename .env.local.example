# ── 환경 대상 ────────────────────────────────────────────────────
# 로컬 기본값은 "스테이징"이다. .env.local.staging / .env.local.prod 를 만들어 두고
# npm run env:staging / env:prod 로 전환한다(파일 교체 — 이 PC 의 모든 세션에 영향).
# 운영을 향한 npm run dev 는 predev 가드가 차단한다(FORCE_PROD_DEV=1 로만 통과).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 회의록 기반 Wiki durable worker(/api/wiki/worker). vercel.json 크론에는 지금 inbox-retention 만 있고 이 워커는 없다.
# 워커 쪽 CRON_SECRET 은 스케줄러가 이 라우트를 부르기 시작할 때 의미가 있다(Vercel Cron 은 GET Authorization: Bearer 로
# 자동 전달). 같은 CRON_SECRET 을 /api/cron/inbox-retention 도 쓴다.
# 자동 추출·반영 진입점의 별도 안전 스위치. 문서 편집과 기존 지식 조회에는 영향을 주지 않습니다.
# 마이그레이션·제안 검토·스테이징 1건 리허설을 마치기 전에는 켜지 마세요.
# WIKI_SERVICE_ENABLED=true
# WIKI_WORKER_ENABLED=true
# CRON_SECRET=replace-with-at-least-16-random-characters
# WIKI_WORKER_SECRET=replace-with-a-separate-manual-worker-secret

# ── 브랜드 (src/lib/branding.ts) ──────────────────────────────────
# 비우면 기본값: 제품명 D-Flow · 태그라인 "일하는 방식이 바뀌다" · 로그인 화면 저작권 줄 없음.
# 빌드 시 클라이언트 번들에 인라인 — 비밀 금지, 바꾸면 재배포.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_COPYRIGHT=
# 메인 포털 아이콘: 비우면 제품명이 기본(D-Flow)일 때 flow(D 글리프), 아니면 monogram(제품명 첫 글자).
# flow/monogram 으로 고정할 수 있다. 파비콘은 SP3 branding 설정에서 다룬다.
NEXT_PUBLIC_BRAND_PORTAL_ICON=

# ── AI 어시스턴트 (챗봇) ──────────────────────────────────────────
# 메뉴 인식형 v2는 안전한 점진 배포를 위해 명시적으로 켜야 합니다.
# 미설정/false이면 UI가 기존 /api/chat/stream으로 자동 복귀합니다.
# CHAT_V2_ENABLED=true
# 선택(실험적): v2 Evidence Pack을 LLM으로 문장화합니다.
# 미설정/false가 운영 기본값이며, 검증 가능한 결정형 근거 답변을 사용합니다.
# CHAT_V2_LLM_SYNTHESIS_ENABLED=true
# 선택(실험적): 모호하거나 교차 메뉴 질문에 제한된 2단계 도구 플래너(LLM)를 시도합니다.
# 미설정/false면 결정형 라우터와 기존 폴백만 사용합니다. LLM 키 필요.
# CHAT_V2_PLANNER_ENABLED=true
# ── AI 어시스턴트 증분 색인 워커(기준선 스키마에 포함) ──
# 보호 라우트 /api/chat/index/worker 활성화 스위치. 미설정이면 라우트가 404입니다.
# CHAT_V2_INDEX_WORKER_ENABLED=true
# 워커 라우트 호출 시크릿(x-cron-secret 헤더). 미설정이면 라우트가 항상 404입니다.
# CHAT_V2_INDEX_CRON_SECRET=long-random-string
# 업무 쓰기 경로의 색인 작업 enqueue 스위치(현재 호출부 미배선 — 헬퍼만 존재).
# CHAT_V2_INDEX_ENQUEUE_ENABLED=true
# Google Gemini 무료 티어 키 하나로 LLM 답변 + pgvector 임베딩을 모두 처리합니다.
# 발급: https://aistudio.google.com/app/apikey  (서버 전용 — NEXT_PUBLIC_ 아님)
# 키가 없어도 봇은 동작합니다(구조화 질의 기반 결정형 답변으로 자동 폴백).
GEMINI_API_KEY=your-google-ai-studio-key
# 선택: 모델 오버라이드 (기본값 표기)
# GEMINI_MODEL=gemini-3.7-flash   # 무료 티어 지원 안정판(GA 2026-08-13). 2.5-flash 는 2026-10-16 셧다운, Pro 계열은 무료 쿼터 0(429) → 쓰지 말 것
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash   # 주 모델 429/5xx 시 순서대로 시도(모델별 쿼터 버킷 분리). ""(빈 값)이면 폴백 없음
# GEMINI_EMBED_MODEL=gemini-embedding-001   # 768차원으로 축소(outputDimensionality) → vector(768)
# 선택: 의미검색 유사도 하한(0~1, 기본 0.35). 이보다 먼 결과는 답변 근거에서 뺀다. 빈 값은 0(컷 해제)이니 쓰지 않으면 주석으로 둘 것.
# ASSISTANT_MIN_SIMILARITY=0.35

# 선택: OpenAI 호환 엔드포인트(Groq/OpenRouter/사내 LLM)로 전환하려면:
# AI_PROVIDER=openai
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small   # 차원은 768 고정(KNOWLEDGE_EMBEDDING_DIMENSIONS, DB vector(768)) — dimensions 축소를 지원하는 모델만

# ── 회의록 업로드 API (또박또박 연동 — docs/design/dflow-minutes-upload-api-spec.md) ──
# 두 값이 모두 설정돼야 /api/v1/minutes* 가 열립니다. 미설정이면 전 라우트 404(존재 은닉).
# MINUTES_API_ENABLED=true
# 시크릿 생성: openssl rand -base64 48 — 또박또박 서버(Rails)에만 보안 채널로 전달, 평문 커밋 금지.
# MINUTES_API_SECRET=long-random-string
#
# folder_path 반영 스위치. 미설정/false(기본)면 POST /minutes 의 folder_path 를 무시한다(400 도 내지 않는다).
# 파트너 측이 folder_path 를 보내기 시작할 때 true 로 켠다 — 전환 조건·순서는
# docs/design/dflow-minutes-upload-api-spec.md §4.8.
# MINUTES_FOLDER_PATH_ENABLED=false

# ── 메일 발송(회의 안내·프로젝트 초대) — SMTP ──
# 공급자 중립(회사 SMTP·Gmail·로컬 inbucket). 공급자 기본값은 없다 — SMTP_HOST 를 비우면 발송 액션이
# throw 하지 않고 { ok:false } 를 반환한다(로컬·Preview 정상 동작). 설정이 잘못되면 화면에는 일반 문구만,
# 원인(키 이름)은 서버 로그 "[mail] SMTP 설정 오류:" 에 남는다.
# 서버 주소. 비우면 메일 발송이 꺼진다.
SMTP_HOST=
# 1–65535 숫자. 비우면 SMTP_SECURE=true 일 때 465, 아니면 587.
SMTP_PORT=
# true|false 만. 비우면 포트가 465 일 때만 true. 465 는 true, 587·25 는 false(STARTTLS)여야 한다.
SMTP_SECURE=
# 비우거나 none 만. none 은 무인증 릴레이 — SMTP_USER·SMTP_PASS 를 비우고 SMTP_FROM_ADDRESS 를 반드시 적는다.
SMTP_AUTH=
# 인증 계정. SMTP_AUTH 가 비었으면 SMTP_PASS 와 둘 다 필요하다. 인증이 있고 SMTP_SECURE=false 면 STARTTLS 를 강제한다.
SMTP_USER=
# 인증 비밀번호(Gmail 은 '앱 비밀번호'). 평문 커밋 금지.
SMTP_PASS=
# 발신 주소. 비우면 SMTP_USER 가 이메일 형식일 때만 그것을 쓰고, 아니면 설정 오류다.
SMTP_FROM_ADDRESS=
#
# 예시 — Gmail(2단계 인증을 켜고 발급한 앱 비밀번호. 계정 비밀번호가 아니다):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@example.com
#   SMTP_PASS=<앱 비밀번호>
# 예시 — 로컬 inbucket(supabase/config.toml [inbucket] 의 smtp_port 주석을 풀고
#   npm run db:stop && npm run db:start. 받은 메일은 http://127.0.0.1:54324):
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=54325
#   SMTP_SECURE=false
#   SMTP_AUTH=none
#   SMTP_FROM_ADDRESS=noreply@example.com
# 발신 표시명 — 서버 전용(NEXT_PUBLIC_ 아님). 비우면 "<제품명> 알림"(NEXT_PUBLIC_BRAND_NAME 기준, 기본 "D-Flow 알림").
MAIL_FROM_NAME=
# 메일 본문 링크의 절대 주소. 없으면 VERCEL_PROJECT_PRODUCTION_URL 로 폴백, 그것도 없으면 링크 생략.
NEXT_PUBLIC_APP_URL=

# ── 프로젝트 초대 (규칙: src/lib/domain/invites.ts) ──
# 쉼표·공백 구분. 비우면 초대 불가, * 는 전체 허용. 거부 안내 문구도 이 목록으로 조립된다.
INVITE_ALLOWED_DOMAINS=
